{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/map(.html)?", "destination": "/app", "permanent": true },
    { "source": "/tasks(.html)?", "destination": "/app", "permanent": true },
    { "source": "/wallet(.html)?", "destination": "/app", "permanent": true },
    { "source": "/profile(.html)?", "destination": "/app", "permanent": true },
    { "source": "/history(.html)?", "destination": "/app", "permanent": true }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
